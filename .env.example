# Copie para .env. Nunca envie .env ao GitHub.
# Supabase: conexão PostgreSQL do servidor (não é a chave anon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Conexão direta/session pooler para migrations. Use SSL conforme o painel Supabase.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# URL exata vista no navegador, sem caminho. Em produção use https://seu-dominio.
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# Execute npm run admin:password e copie SOMENTE o hash gerado.
ADMIN_PASSWORD_HASH=""
# Chave exclusivamente do servidor. Nunca use NEXT_PUBLIC_ para esta chave.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="site-media"

# CRM: bucket privado e segredo compartilhado com o conector
CRM_STORAGE_BUCKET="crm-private"
CRM_CONNECTOR_SECRET=""
