generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             String @id @default(cuid())
  name           String
  slug           String @unique
  primaryColor   String @default("#BA2018")
  secondaryColor String @default("#FEE2E2")

  products Product[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  published   Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String   @default("")
  position  Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("site")
  data      Json
  updatedAt DateTime @updatedAt
}

model AdminSession {
  tokenHash String   @id
  identity  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  path      String   @unique
  createdAt DateTime @default(now())
}
