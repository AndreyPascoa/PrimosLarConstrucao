generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             String @id @default(cuid())
  name           String
  slug           String @unique
  primaryColor   String @default("#BA2018")
  secondaryColor String @default("#FEE2E2")

  products Product[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  published   Boolean @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String   @default("")
  position  Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default("site")
  data      Json
  updatedAt DateTime @updatedAt
}

model AdminSession {
  tokenHash String   @id
  identity  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model Media {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  path      String   @unique
  createdAt DateTime @default(now())
}

model Seller {
  id String @id @default(cuid())
  name String
  phone String
  active Boolean @default(true)
  schedule Json
  lastAssignedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quotes Quote[]
}

model Quote {
  id String @id @default(cuid())
  requestKey String @unique
  sellerId String
  seller Seller @relation(fields: [sellerId], references: [id])
  sellerName String
  sellerPhone String
  items Json
  message String
  status String @default("forwarded")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([sellerId, createdAt])
}

model CrmUser {
 id String @id @default(cuid())
 sellerId String @unique
 email String @unique
 passwordHash String
 active Boolean @default(true)
 createdAt DateTime @default(now())
}
model CrmSession {
 tokenHash String @id
 userId String
 identity String
 expiresAt DateTime
}
model WaAccount {
 id String @id @default(cuid())
 sellerId String @unique
 status String @default("disconnected")
 qr String?
 qrExpiresAt DateTime?
 command String @default("disconnect")
 commandId String @default("")
 heartbeatAt DateTime?
 updatedAt DateTime @updatedAt
 conversations CrmConversation[]
}
model CrmConversation {
 id String @id @default(cuid())
 accountId String
 account WaAccount @relation(fields:[accountId],references:[id])
 phone String
 name String @default("")
 assignedSellerId String
 stage String @default("new")
 notes String @default("")
 quoteId String?
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())
 messages CrmMessage[]
 attachments CrmAttachment[]
 @@unique([accountId,phone])
 @@index([assignedSellerId,updatedAt])
}
model CrmAttachment {
 id String @id @default(cuid())
 conversationId String
 conversation CrmConversation @relation(fields:[conversationId],references:[id])
 name String
 path String @unique
 mime String
 size Int
 createdAt DateTime @default(now())
 messages CrmMessage[]
}
model CrmMessage {
 id String @id @default(cuid())
 conversationId String
 conversation CrmConversation @relation(fields:[conversationId],references:[id])
 requestKey String? @unique
 externalKey String? @unique
 direction String
 body String @default("")
 attachmentId String?
 attachment CrmAttachment? @relation(fields:[attachmentId],references:[id])
 status String @default("queued")
 error String?
 author String?
 claimedAt DateTime?
 createdAt DateTime @default(now())
 @@index([conversationId,createdAt])
 @@index([status,createdAt])
}
